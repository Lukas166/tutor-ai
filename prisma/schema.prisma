generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// BETTER AUTH TABLES (modified)
// ==========================================

model User {
  id            String  @id
  name          String
  email         String  @unique
  emailVerified Boolean
  image         String?

  // Custom fields
  role          String  @default("mahasiswa") // admin | dosen | mahasiswa
  academicLevel String? // S1 | S2 | S3 — hanya untuk mahasiswa
  npm           String? @unique // Nomor Pokok Mahasiswa — hanya untuk mahasiswa
  major         String? // jurusan
  faculty       String? // fakultas
  bio           String?

  createdAt DateTime
  updatedAt DateTime

  // Better Auth relations
  sessions Session[]
  accounts Account[]

  // App relations
  coursesCreated     Course[]           @relation("CourseCreator")
  courseInstructor   CourseInstructor[]
  enrollments        Enrollment[]
  courseSessionsMade CourseSession[]    @relation("CourseSessionCreator")
  materialsUploaded  Material[]
  aiChatSessions     AiChatSession[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

// ==========================================
// COURSE MANAGEMENT
// ==========================================

model Course {
  id            String   @id
  createdBy     String
  title         String
  description   String?
  coverImage    String?
  enrollmentKey String   @unique // auto-generated 8 karakter, dipakai mahasiswa untuk join
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator        User               @relation("CourseCreator", fields: [createdBy], references: [id])
  instructors    CourseInstructor[]
  enrollments    Enrollment[]
  sessions       CourseSession[]
  materialChunks MaterialChunk[]
  aiChatSessions AiChatSession[]

  @@index([enrollmentKey])
  @@map("course")
}

// Satu course bisa diampu banyak dosen
model CourseInstructor {
  id         String   @id
  courseId   String
  userId     String // hanya role dosen
  assignedAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@map("course_instructor")
}

// Mahasiswa join course via enrollmentKey
model Enrollment {
  id         String   @id
  courseId   String
  userId     String // hanya role mahasiswa
  isActive   Boolean  @default(true) // false = akses dicabut tanpa hapus histori
  enrolledAt DateTime @default(now())

  course   Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress EnrollmentProgress[]

  @@unique([courseId, userId])
  @@index([userId])
  @@map("enrollment")
}

// ==========================================
// COURSE CONTENT
// ==========================================

// Minggu 1, Minggu 2, dst — unit konten dalam course
model CourseSession {
  id          String   @id
  courseId    String
  createdBy   String
  title       String // contoh: Minggu 1 - Pengenalan AI
  description String?
  orderNumber Int      @default(1) // urutan tampil, unik per course
  isActive    Boolean  @default(true) // false = tersembunyi dari mahasiswa
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course         Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator        User                 @relation("CourseSessionCreator", fields: [createdBy], references: [id])
  materials      Material[]
  materialChunks MaterialChunk[]
  progress       EnrollmentProgress[]
  aiChatSessions AiChatSession[]

  @@unique([courseId, orderNumber])
  @@index([courseId])
  @@map("course_session")
}

// Tracking apakah mahasiswa sudah membuka sesi tertentu
model EnrollmentProgress {
  id              String    @id
  enrollmentId    String
  courseSessionId String
  isVisited       Boolean   @default(false)
  visitedAt       DateTime? // timestamp pertama kali dibuka
  lastVisitedAt   DateTime?

  enrollment    Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  courseSession CourseSession @relation(fields: [courseSessionId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, courseSessionId])
  @@map("enrollment_progress")
}

// File PDF yang diunggah per sesi — satu sesi bisa punya banyak PDF
model Material {
  id              String   @id
  courseSessionId String
  uploadedBy      String
  title           String
  materialType    String   @default("file") // file | link | text
  description     String?
  fileName        String
  filePath        String // legacy path/url agar data lama tetap kompatibel
  storagePath     String? // path object di Supabase Storage
  publicUrl       String? // URL publik file dari Supabase Storage
  externalUrl     String? // URL untuk materi bertipe link
  textContent     String? // konten untuk materi bertipe text
  fileSize        BigInt? // ukuran dalam bytes
  isActive        Boolean  @default(true)
  isProcessed     Boolean  @default(false) // true = embedding selesai, siap dipakai RAG
  processingStatus String   @default("uploaded") // uploaded | queued | processing | extracting | ocr | chunking | embedding | indexing | ready | failed
  processingProgress Int    @default(0)
  processingError String?
  processingJobId String?
  processingStartedAt DateTime?
  processingCompletedAt DateTime?
  pageCount       Int      @default(0)
  chunkCount      Int      @default(0)
  embeddingModel  String?
  embeddingDimensions Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt @default(now())

  courseSession CourseSession @relation(fields: [courseSessionId], references: [id], onDelete: Cascade)
  uploader      User          @relation(fields: [uploadedBy], references: [id])
  pages         MaterialPage[]
  chunks        MaterialChunk[]
  processingLogs MaterialProcessingLog[]

  @@index([courseSessionId])
  @@index([isProcessed])
  @@index([processingStatus])
  @@map("material")
}

// ==========================================
// RAG — VECTOR KNOWLEDGE BASE
// ==========================================

model MaterialPage {
  id                String   @id
  materialId        String
  pageNumber        Int
  embeddedText      String?
  ocrText           String?
  finalText         String
  textCharCount     Int      @default(0)
  imageOcrAttempted Boolean  @default(false)
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, pageNumber])
  @@index([materialId])
  @@map("material_page")
}

model MaterialChunk {
  id         String   @id
  materialId String
  courseId   String
  sessionId  String
  pageNumber Int
  chunkIndex Int
  content    String
  tokenCount Int
  embedding  Unsupported("vector(768)")?
  chunkType  String   @default("page_text")
  metadata   Json?
  createdAt  DateTime @default(now())

  material      Material      @relation(fields: [materialId], references: [id], onDelete: Cascade)
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseSession CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([materialId, chunkIndex])
  @@index([materialId])
  @@index([courseId])
  @@index([sessionId])
  @@index([courseId, sessionId])
  @@index([materialId, pageNumber])
  @@map("material_chunk")
}

model MaterialProcessingLog {
  id         String   @id
  materialId String
  status     String
  message    String
  error      String?
  metadata   Json?
  createdAt  DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, createdAt])
  @@map("material_processing_log")
}

// ==========================================
// TUTOR AI — CHAT
// ==========================================

model AiChatSession {
  id              String   @id
  userId          String
  courseId        String
  courseSessionId String // RAG hanya query chunk dari sesi ini
  startedAt       DateTime @default(now())
  lastActiveAt    DateTime @default(now())

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course          @relation(fields: [courseId], references: [id])
  courseSession CourseSession   @relation(fields: [courseSessionId], references: [id])
  messages      AiChatMessage[]

  @@index([userId, courseSessionId])
  @@index([userId])
  @@map("ai_chat_session")
}

model AiChatMessage {
  id              String   @id
  aiChatSessionId String
  senderType      String // user | ai
  content         String // teks pesan
  audioUrl        String? // URL file TTS
  ragSources      Json? // chunk IDs + similarity score
  responseTimeMs  Int? // latensi AI dalam ms
  createdAt       DateTime @default(now())

  aiChatSession AiChatSession @relation(fields: [aiChatSessionId], references: [id], onDelete: Cascade)

  @@index([aiChatSessionId])
  @@map("ai_chat_message")
}

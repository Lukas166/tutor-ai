{
  "name": "tutor-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,worker -c cyan,yellow npm:dev:next npm:dev:worker",
    "dev:next": "next dev --turbo",
    "dev:worker": "tsx src/workers/material-processing.worker.ts",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "concurrently -n next,worker -c cyan,yellow npm:start:next npm:start:worker",
    "start:next": "next start",
    "start:worker": "tsx src/workers/material-processing.worker.ts",
    "lint": "eslint",
    "worker:materials": "tsx src/workers/material-processing.worker.ts",
    "worker:materials:once": "tsx src/workers/material-processing.worker.ts --once"
  },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@langchain/textsplitters": "^1.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.9",
    "canvas": "^3.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.2.0",
    "katex": "^0.16.47",
    "lucide": "^1.3.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
